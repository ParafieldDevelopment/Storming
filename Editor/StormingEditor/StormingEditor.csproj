<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net7.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <RootNamespace>StormingEditor</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compile all C# source files -->
        <Compile Include="**\*.cs" />

        <!-- Include all XAML pages -->
        <Page Include="**\*.xaml" />
    </ItemGroup>

    <ItemGroup>
        <!-- Optional: include references here if needed later -->
        <!-- Example: <PackageReference Include="Newtonsoft.Json" Version="13.0.1" /> -->
    </ItemGroup>

</Project>
